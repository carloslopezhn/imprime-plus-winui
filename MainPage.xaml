<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ImprimePlus.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ImprimePlus"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource BgBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ TOOLBAR ============ -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE749;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}">
                        <Run Text="Imprime" /><Run Text="+" Foreground="{StaticResource AccentBrush}" />
                    </TextBlock>
                </StackPanel>

                <!-- Actions -->
                <ScrollViewer Grid.Column="1" HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarPrimaryButton}" ToolTipService.ToolTip="Agregar imágenes"
                                Click="OnAddImages">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                                <TextBlock Text="Agregar" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Agregar desde comprimido (ZIP, RAR, 7Z, TAR...)"
                                Click="OnAddArchive">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Comprimido" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Pegar desde portapapeles (Ctrl+V)"
                                Click="OnPaste">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE77F;" FontSize="14" />
                                <TextBlock Text="Pegar" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Alejar" Click="OnZoomOut">
                            <FontIcon Glyph="&#xE738;" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Acercar" Click="OnZoomIn">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Ajustar a ventana" Click="OnZoomFit">
                            <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Modo póster: una imagen en varias páginas">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE80A;" FontSize="14" />
                                <TextBlock Text="Póster" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <ComboBox MinWidth="150" VerticalAlignment="Center" ToolTipService.ToolTip="Seleccionar impresora"
                                  PlaceholderText="Cargando impresoras..." />
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Configuración de impresora">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ToolbarPrimaryButton}" ToolTipService.ToolTip="Imprimir todas las páginas"
                                Click="OnPrint">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE749;" FontSize="14" />
                                <TextBlock Text="Imprimir" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Limpiar configuraciones individuales">
                            <FontIcon Glyph="&#xED60;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Vaciar todo" Click="OnClearAll">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Vaciar" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Verificar actualizaciones">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ CONTENT: 3 paneles ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- ===== Panel izquierdo: Ajustes Globales ===== -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource PanelTextBrush}" />
                            <TextBlock Text="Ajustes Globales" FontWeight="SemiBold" FontSize="13.5"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="14,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">

                            <!-- Página -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="PÁGINA" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Carta — 21.59 x 27.94 cm" FontSize="13"
                                           Foreground="{StaticResource PanelTextBrush}" />
                                <Button HorizontalAlignment="Stretch" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE713;" FontSize="13" />
                                        <TextBlock Text="Configurar página" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Modo Póster -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="MODO PÓSTER" Style="{StaticResource SectionTitle}" />
                                <ToggleSwitch Header="" OnContent="Activado" OffContent="Desactivado" />
                            </StackPanel>

                            <!-- Distribución -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="DISTRIBUCIÓN" Style="{StaticResource SectionTitle}" />

                                <StackPanel Spacing="3">
                                    <TextBlock Text="Modo" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectedIndex="0"
                                              SelectionChanged="OnModeChanged">
                                        <ComboBoxItem Content="Filas x Columnas" />
                                        <ComboBoxItem Content="Cantidad por página" />
                                        <ComboBoxItem Content="Por tamaño de imagen" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Modo grid: filas x columnas -->
                                <Grid x:Name="GridPanel" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="Filas" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="RowsBox" AutomationProperties.AutomationId="RowsBox" Text="3" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Columnas" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ColsBox" AutomationProperties.AutomationId="ColsBox" Text="3" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                </Grid>

                                <!-- Modo count: imágenes por página -->
                                <StackPanel x:Name="CountPanel" Spacing="3" Visibility="Collapsed">
                                    <TextBlock Text="Imágenes por página" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CountBox" Text="9" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                </StackPanel>

                                <!-- Modo size: ancho x alto de imagen -->
                                <Grid x:Name="SizePanel" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="Ancho img (cm)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ImgWBox" Text="5" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Alto img (cm)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ImgHBox" Text="5" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="Espacio H (cm)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SpacingHBox" Text="0.3" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Espacio V (cm)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SpacingVBox" Text="0.3" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                </Grid>

                                <ToggleSwitch x:Name="MarginsToggle" OnContent="Márgenes activados" OffContent="Sin márgenes"
                                              Toggled="OnMarginsToggled" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== Centro: lienzo Win2D (Direct2D / GPU) ===== -->
            <Grid Grid.Column="1" x:Name="CanvasHost" AllowDrop="True"
                  DragOver="OnCanvasDragOver" Drop="OnCanvasDrop" Background="Transparent">
                <canvas:CanvasControl x:Name="PageCanvas" Draw="PageCanvas_Draw" ClearColor="#FFE8EDF3"
                                      PointerWheelChanged="OnCanvasWheel"
                                      PointerPressed="OnCanvasPressed"
                                      PointerMoved="OnCanvasMoved"
                                      PointerReleased="OnCanvasReleased"
                                      PointerExited="OnCanvasReleased" />
                <TextBlock x:Name="EmptyHint" Text="Arrastra imágenes aquí — o usa Agregar / Pegar / Comprimido"
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
            </Grid>

            <!-- ===== Panel derecho: Inspector ===== -->
            <Border Grid.Column="2" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{StaticResource PanelTextBrush}" />
                            <TextBlock Text="Inspector" FontWeight="SemiBold" FontSize="13.5"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Estado vacío -->
                        <StackPanel x:Name="InspectorEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="20">
                            <FontIcon Glyph="&#xE7C3;" FontSize="34" Foreground="{StaticResource BorderBrush2}" />
                            <TextBlock Text="Selecciona una imagen" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock Text="para editar zoom, forma, borde, filtros y título"
                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Controles per-imagen -->
                        <ScrollViewer x:Name="InspectorContent" Padding="14,12" VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <StackPanel Spacing="16">

                                <!-- Encaje -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ENCAJE" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Ajuste" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="InsFit" HorizontalAlignment="Stretch" SelectionChanged="OnInsFitChanged">
                                            <ComboBoxItem Content="Cubrir" />
                                            <ComboBoxItem Content="Contener" />
                                            <ComboBoxItem Content="Estirar" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="Zoom interno" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsZoom" Minimum="20" Maximum="300" Value="100"
                                            ValueChanged="OnInsZoomChanged" />
                                    <Button Content="Rotar 90°" HorizontalAlignment="Stretch" Click="OnInsRotate" />
                                </StackPanel>

                                <!-- Forma y borde -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="FORMA Y BORDE" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Forma" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="InsShape" HorizontalAlignment="Stretch" SelectionChanged="OnInsShapeChanged">
                                            <ComboBoxItem Content="Rectángulo" />
                                            <ComboBoxItem Content="Redondeado" />
                                            <ComboBoxItem Content="Circular" />
                                            <ComboBoxItem Content="Hexágono" />
                                            <ComboBoxItem Content="Estrella" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="Radio de esquina" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsRadius" Minimum="0" Maximum="80" Value="14" ValueChanged="OnInsRadiusChanged" />
                                    <TextBlock Text="Ancho de borde" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsBorder" Minimum="0" Maximum="20" Value="0" ValueChanged="OnInsBorderChanged" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Color de borde" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                        <Button x:Name="InsBorderColorBtn" Width="36" Height="26" Padding="0">
                                            <Border x:Name="InsBorderSwatch" Background="White" Width="24" Height="14"
                                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker x:Name="InsBorderPicker" ColorSpectrumShape="Ring"
                                                                 IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                                                 IsHexInputVisible="True" ColorChanged="OnInsBorderColorChanged" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Filtros -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="FILTROS" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Brillo" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsBrightness" Minimum="0" Maximum="200" Value="100" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Contraste" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsContrast" Minimum="0" Maximum="200" Value="100" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Saturación" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsSaturation" Minimum="0" Maximum="200" Value="100" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Escala de grises" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsGrayscale" Minimum="0" Maximum="100" Value="0" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Sepia" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsSepia" Minimum="0" Maximum="100" Value="0" ValueChanged="OnInsFilterChanged" />
                                    <Button Content="Restablecer filtros" HorizontalAlignment="Stretch" Click="OnInsResetFilters" />
                                </StackPanel>

                                <!-- Título -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="TÍTULO" Style="{StaticResource SectionTitle}" />
                                    <TextBox x:Name="InsCaptionText" PlaceholderText="Texto del título"
                                             TextChanged="OnInsCaptionTextChanged" />
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Posición" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="InsCaptionPos" HorizontalAlignment="Stretch" SelectionChanged="OnInsCaptionPosChanged">
                                            <ComboBoxItem Content="Ninguno" />
                                            <ComboBoxItem Content="Debajo" />
                                            <ComboBoxItem Content="Arriba" />
                                            <ComboBoxItem Content="Encima" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
