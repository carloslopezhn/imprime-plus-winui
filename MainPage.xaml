<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ImprimePlus.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ImprimePlus"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource BgBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ TOOLBAR ============ -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xF500;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="Bold">
                        <Run Text="Imprime" Foreground="{StaticResource AccentBrush}" /><Run Text="+" Foreground="{StaticResource BrandPlusBrush}" FontWeight="ExtraBold" />
                    </TextBlock>
                </StackPanel>

                <!-- Actions -->
                <ScrollViewer Grid.Column="1" HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarPrimaryButton}" ToolTipService.ToolTip="Agregar imágenes"
                                Click="OnAddImages">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xF42B;" FontSize="14" />
                                <TextBlock Text="Agregar" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Agregar desde comprimido (ZIP, RAR, 7Z, TAR...)"
                                Click="OnAddArchive">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xF391;" FontSize="14" />
                                <TextBlock Text="Comprimido" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Pegar desde portapapeles (Ctrl+V)"
                                Click="OnPaste">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xF290;" FontSize="14" />
                                <TextBlock Text="Pegar" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Alejar" Click="OnZoomOut">
                            <FontIcon Glyph="&#xF63B;" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Acercar" Click="OnZoomIn">
                            <FontIcon Glyph="&#xF64D;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Ajustar a ventana" Click="OnZoomFit">
                            <FontIcon Glyph="&#xF14D;" FontSize="14" />
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Modo póster: una imagen en varias páginas"
                                Click="OnPosterButton">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xF310;" FontSize="14" />
                                <TextBlock Text="Póster" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <ComboBox x:Name="PrinterCombo" MinWidth="150" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Seleccionar impresora" PlaceholderText="Sin impresoras" />
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Configuración de impresora"
                                Click="OnPrinterConfig">
                            <FontIcon Glyph="&#xF56B;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Exportar a PDF" Click="OnExportPdf">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xF63E;" FontSize="14" />
                                <TextBlock Text="PDF" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PrintBtn" Style="{StaticResource ToolbarPrimaryButton}" ToolTipService.ToolTip="Imprimir todas las páginas"
                                Click="OnPrint">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xF501;" FontSize="14" />
                                <TextBlock Text="Imprimir" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Limpiar configuraciones individuales">
                            <FontIcon Glyph="&#xF331;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Vaciar todo" Click="OnClearAll">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xF78B;" FontSize="14" />
                                <TextBlock Text="Vaciar" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="6,8" Background="{StaticResource BorderBrush2}" />

                        <Button Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="Verificar actualizaciones"
                                Click="OnCheckUpdate">
                            <FontIcon Glyph="&#xF295;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ CONTENT: 3 paneles ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- ===== Panel izquierdo: Ajustes Globales ===== -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10" Background="{StaticResource AccentBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xF3E5;" FontSize="14" Foreground="White" />
                            <TextBlock Text="Ajustes Globales" FontWeight="Bold" FontSize="13.5" Foreground="White" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="14,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">

                            <!-- Página -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xF392;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="PÁGINA" Style="{StaticResource SectionTitle}" Margin="0" />
                                </StackPanel>
                                <TextBlock x:Name="PageSummary" Text="Carta — 21.59 x 27.94 cm" FontSize="13"
                                           Foreground="{StaticResource PanelTextBrush}" TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="OnConfigPage">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xF3E5;" FontSize="13" />
                                        <TextBlock Text="Configurar página" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Modo Póster -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xF310;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="MODO PÓSTER" Style="{StaticResource SectionTitle}" Margin="0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PosterToggle" OnContent="Activado" OffContent="Desactivado"
                                              Toggled="OnPosterToggled" />
                                <StackPanel x:Name="PosterOptions" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="Una sola imagen dividida en varias páginas"
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Horizontal" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="PosterColsBox" Text="2" InputScope="Number" TextChanged="OnPosterFieldChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Vertical" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="PosterRowsBox" Text="2" InputScope="Number" TextChanged="OnPosterFieldChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- Distribución -->
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xF3FA;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="DISTRIBUCIÓN" Style="{StaticResource SectionTitle}" Margin="0" />
                                </StackPanel>

                                <StackPanel Spacing="3">
                                    <TextBlock Text="Modo" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectedIndex="0"
                                              SelectionChanged="OnModeChanged">
                                        <ComboBoxItem Content="Filas x Columnas" />
                                        <ComboBoxItem Content="Cantidad por página" />
                                        <ComboBoxItem Content="Por tamaño de imagen" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Modo grid: filas x columnas -->
                                <Grid x:Name="GridPanel" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="Filas" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="RowsBox" AutomationProperties.AutomationId="RowsBox" Text="3" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Columnas" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ColsBox" AutomationProperties.AutomationId="ColsBox" Text="3" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                </Grid>

                                <!-- Modo count: imágenes por página -->
                                <StackPanel x:Name="CountPanel" Spacing="3" Visibility="Collapsed">
                                    <TextBlock Text="Imágenes por página" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CountBox" Text="9" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                </StackPanel>

                                <!-- Modo size: ancho x alto de imagen -->
                                <Grid x:Name="SizePanel" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="Ancho img (cm)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ImgWBox" Text="5" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Alto img (cm)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ImgHBox" Text="5" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="Espacio H (cm)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SpacingHBox" Text="0" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Espacio V (cm)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SpacingVBox" Text="0" InputScope="Number" TextChanged="OnLayoutFieldChanged" />
                                    </StackPanel>
                                </Grid>

                                <ToggleSwitch x:Name="MarginsToggle" OnContent="Márgenes activados" OffContent="Sin márgenes"
                                              Toggled="OnMarginsToggled" />
                                <StackPanel x:Name="MarginsPanel" Spacing="6" Visibility="Collapsed">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Superior" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="MarginTopBox" Text="1" InputScope="Number" TextChanged="OnMarginFieldChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Inferior" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="MarginBottomBox" Text="1" InputScope="Number" TextChanged="OnMarginFieldChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Izquierda" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="MarginLeftBox" Text="1" InputScope="Number" TextChanged="OnMarginFieldChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Derecha" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="MarginRightBox" Text="1" InputScope="Number" TextChanged="OnMarginFieldChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <ToggleSwitch x:Name="CutGuidesToggle" OnContent="Guías de corte" OffContent="Guías de corte"
                                              Toggled="OnCutGuidesToggled" />
                            </StackPanel>

                            <!-- Imágenes (global) -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xF42A;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="IMÁGENES (GLOBAL)" Style="{StaticResource SectionTitle}" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="Forma" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="GShape" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnGlobalChanged">
                                    <ComboBoxItem Content="Rectángulo" />
                                    <ComboBoxItem Content="Redondeado" />
                                    <ComboBoxItem Content="Circular" />
                                </ComboBox>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="Borde" Style="{StaticResource FieldLabel}" />
                                        <Slider x:Name="GBorder" Minimum="0" Maximum="20" Value="0" ValueChanged="OnGlobalSlider" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Bottom">
                                        <TextBlock Text="Color" Style="{StaticResource FieldLabel}" />
                                        <Button Width="40" Height="30" Padding="0">
                                            <Border x:Name="GBorderSwatch" Background="Black" Width="26" Height="16"
                                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker x:Name="GBorderPicker" ColorSpectrumShape="Ring"
                                                                 IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                                                 IsHexInputVisible="True" ColorChanged="OnGlobalBorderColor" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Radio" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="GRadius" Minimum="0" Maximum="80" Value="0" ValueChanged="OnGlobalSlider" />
                                <TextBlock Text="Sombra" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="GShadow" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnGlobalChanged">
                                    <ComboBoxItem Content="Ninguna" />
                                    <ComboBoxItem Content="Suave" />
                                    <ComboBoxItem Content="Media" />
                                    <ComboBoxItem Content="Fuerte" />
                                </ComboBox>
                                <TextBlock Text="Ajuste" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="GFit" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="OnGlobalChanged">
                                    <ComboBoxItem Content="Cubrir (recortar)" />
                                    <ComboBoxItem Content="Contener (completa)" />
                                    <ComboBoxItem Content="Estirar" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Fondo celda" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                    <Button Width="40" Height="28" Padding="0">
                                        <Border x:Name="GCellSwatch" Background="White" Width="26" Height="14"
                                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="GCellPicker" ColorSpectrumShape="Ring"
                                                             IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                                             IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="OnGlobalCellBg" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Alineación horizontal" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="GAlignH" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="OnGlobalChanged">
                                    <ComboBoxItem Content="Izquierda" />
                                    <ComboBoxItem Content="Centro" />
                                    <ComboBoxItem Content="Derecha" />
                                    <ComboBoxItem Content="Justificado" />
                                </ComboBox>
                                <TextBlock Text="Alineación vertical" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="GAlignV" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="OnGlobalChanged">
                                    <ComboBoxItem Content="Arriba" />
                                    <ComboBoxItem Content="Centro" />
                                    <ComboBoxItem Content="Abajo" />
                                </ComboBox>

                                <!-- Títulos (global) -->
                                <TextBlock Text="TÍTULOS (GLOBAL)" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" />
                                <ToggleSwitch x:Name="GCapOn" OnContent="Mostrar títulos" OffContent="Mostrar títulos"
                                              Toggled="OnGlobalCaptionToggle" />
                                <TextBlock Text="Contenido" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="GCapSource" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnGlobalCaptionSel">
                                    <ComboBoxItem Content="Nombre de archivo" />
                                    <ComboBoxItem Content="Número" />
                                </ComboBox>
                                <ToggleSwitch x:Name="GCapExt" OnContent="Con extensión" OffContent="Sin extensión"
                                              Toggled="OnGlobalCaptionToggle" />
                                <TextBlock Text="Posición" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="GCapPos" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnGlobalCaptionSel">
                                    <ComboBoxItem Content="Debajo" />
                                    <ComboBoxItem Content="Encima" />
                                    <ComboBoxItem Content="Sobre la imagen" />
                                </ComboBox>
                                <TextBlock Text="Tipografía" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="GCapFont" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnGlobalCaptionSel">
                                    <ComboBoxItem Content="Segoe UI" />
                                    <ComboBoxItem Content="Arial" />
                                    <ComboBoxItem Content="Georgia" />
                                    <ComboBoxItem Content="Courier New" />
                                    <ComboBoxItem Content="Times New Roman" />
                                    <ComboBoxItem Content="Verdana" />
                                    <ComboBoxItem Content="Impact" />
                                </ComboBox>
                                <TextBlock Text="Tamaño de fuente" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="GCapSize" Minimum="6" Maximum="48" Value="14" ValueChanged="OnGlobalCaptionSlider" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Texto" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                        <Button Width="38" Height="26" Padding="0">
                                            <Border x:Name="GCapColorSwatch" Background="Black" Width="24" Height="14"
                                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker x:Name="GCapColorPicker" ColorSpectrumShape="Ring"
                                                                 IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                                                 IsHexInputVisible="True" ColorChanged="OnGlobalCaptionColor" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Fondo" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                        <Button Width="38" Height="26" Padding="0">
                                            <Border x:Name="GCapBgSwatch" Background="Transparent" Width="24" Height="14"
                                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker x:Name="GCapBgPicker" ColorSpectrumShape="Ring"
                                                                 IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                                                 IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="OnGlobalCaptionBg" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== Centro: lienzo Win2D (Direct2D / GPU) + nav de páginas ===== -->
            <Grid Grid.Column="1" x:Name="CanvasHost" AllowDrop="True"
                  DragOver="OnCanvasDragOver" Drop="OnCanvasDrop" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <canvas:CanvasControl x:Name="PageCanvas" Draw="PageCanvas_Draw" ClearColor="#FFE8EDF3"
                                          IsTabStop="True" UseSystemFocusVisuals="False"
                                          IsDoubleTapEnabled="True"
                                          PointerWheelChanged="OnCanvasWheel"
                                          PointerPressed="OnCanvasPressed"
                                          PointerMoved="OnCanvasMoved"
                                          PointerReleased="OnCanvasReleased"
                                          PointerExited="OnCanvasReleased"
                                          DoubleTapped="OnCanvasDoubleTapped"
                                          KeyDown="OnCanvasKeyDown" />
                    <TextBlock x:Name="EmptyHint" Text="Arrastra imágenes aquí — o usa Agregar / Pegar / Comprimido"
                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
                </Grid>

                <!-- Barra de navegación de páginas (.page-nav) -->
                <Border Grid.Row="1" x:Name="PageNavBar" Background="{StaticResource BgPanelBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="8,6"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <Button x:Name="NavFirst" Style="{StaticResource ToolbarButton}" Click="OnNavFirst"
                                ToolTipService.ToolTip="Primera página"><FontIcon Glyph="&#xF276;" FontSize="13" /></Button>
                        <Button x:Name="NavPrev" Style="{StaticResource ToolbarButton}" Click="OnNavPrev"
                                ToolTipService.ToolTip="Anterior"><FontIcon Glyph="&#xF284;" FontSize="13" /></Button>
                        <TextBlock x:Name="PageNavLabel" Text="Página 1 de 1" VerticalAlignment="Center"
                                   MinWidth="120" TextAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource PanelTextBrush}" />
                        <Button x:Name="NavNext" Style="{StaticResource ToolbarButton}" Click="OnNavNext"
                                ToolTipService.ToolTip="Siguiente"><FontIcon Glyph="&#xF285;" FontSize="13" /></Button>
                        <Button x:Name="NavLast" Style="{StaticResource ToolbarButton}" Click="OnNavLast"
                                ToolTipService.ToolTip="Última página"><FontIcon Glyph="&#xF277;" FontSize="13" /></Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Panel derecho: Inspector ===== -->
            <Border Grid.Column="2" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10" Background="{StaticResource AccentBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xF56B;" FontSize="14" Foreground="White" />
                            <TextBlock Text="Imagen seleccionada" FontWeight="Bold" FontSize="13.5" Foreground="White" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Estado vacío -->
                        <StackPanel x:Name="InspectorEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="24">
                            <FontIcon Glyph="&#xF403;" FontSize="36" Foreground="{StaticResource BorderBrush2}" HorizontalAlignment="Center" />
                            <TextBlock Text="Clic en imagen para editar. Ctrl+clic para seleccionar varias."
                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Controles per-imagen -->
                        <ScrollViewer x:Name="InspectorContent" Padding="14,12" VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <StackPanel Spacing="16">

                                <!-- Encaje -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ENCAJE" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Ajuste" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="InsFit" HorizontalAlignment="Stretch" SelectionChanged="OnInsFitChanged">
                                            <ComboBoxItem Content="- Usar global -" />
                                            <ComboBoxItem Content="Cubrir" />
                                            <ComboBoxItem Content="Contener" />
                                            <ComboBoxItem Content="Estirar" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="Zoom interno" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsZoom" Minimum="20" Maximum="300" Value="100"
                                            ValueChanged="OnInsZoomChanged" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Offset X" Style="{StaticResource FieldLabel}" />
                                            <Slider x:Name="InsOffsetX" Minimum="-200" Maximum="200" Value="0" ValueChanged="OnInsOffsetChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Offset Y" Style="{StaticResource FieldLabel}" />
                                            <Slider x:Name="InsOffsetY" Minimum="-200" Maximum="200" Value="0" ValueChanged="OnInsOffsetChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="↺ Rotar izq" HorizontalAlignment="Stretch" Click="OnInsRotateLeft" />
                                        <Button Grid.Column="1" Content="Rotar der ↻" HorizontalAlignment="Stretch" Click="OnInsRotate" />
                                    </Grid>
                                    <Button Content="Quitar fondo" HorizontalAlignment="Stretch" Click="OnRemoveBg" />
                                    <Button x:Name="InsRestoreBtn" Content="Restaurar original" HorizontalAlignment="Stretch"
                                            Click="OnRestoreOriginal" Visibility="Collapsed" />
                                    <Button Content="Eliminar imagen" HorizontalAlignment="Stretch" Click="OnInsDelete"
                                            Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" />
                                </StackPanel>

                                <!-- Forma y borde -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="FORMA Y BORDE" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Forma" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="InsShape" HorizontalAlignment="Stretch" SelectionChanged="OnInsShapeChanged">
                                            <ComboBoxItem Content="- Usar global -" />
                                            <ComboBoxItem Content="Rectángulo" />
                                            <ComboBoxItem Content="Redondeado" />
                                            <ComboBoxItem Content="Circular" />
                                            <ComboBoxItem Content="Hexágono" />
                                            <ComboBoxItem Content="Estrella" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="Radio de esquina" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsRadius" Minimum="0" Maximum="80" Value="14" ValueChanged="OnInsRadiusChanged" />
                                    <TextBlock Text="Ancho de borde" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsBorder" Minimum="0" Maximum="20" Value="0" ValueChanged="OnInsBorderChanged" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Color de borde" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                        <Button x:Name="InsBorderColorBtn" Width="36" Height="26" Padding="0">
                                            <Border x:Name="InsBorderSwatch" Background="White" Width="24" Height="14"
                                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker x:Name="InsBorderPicker" ColorSpectrumShape="Ring"
                                                                 IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                                                 IsHexInputVisible="True" ColorChanged="OnInsBorderColorChanged" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Filtros -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="FILTROS" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Brillo" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsBrightness" Minimum="0" Maximum="200" Value="100" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Contraste" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsContrast" Minimum="0" Maximum="200" Value="100" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Saturación" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsSaturation" Minimum="0" Maximum="200" Value="100" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Escala de grises" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsGrayscale" Minimum="0" Maximum="100" Value="0" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Sepia" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsSepia" Minimum="0" Maximum="100" Value="0" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Tono" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsHue" Minimum="0" Maximum="360" Value="0" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Desenfoque" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsBlur" Minimum="0" Maximum="10" StepFrequency="0.5" Value="0" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Invertir" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsInvert" Minimum="0" Maximum="100" Value="0" ValueChanged="OnInsFilterChanged" />
                                    <TextBlock Text="Opacidad" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsOpacity" Minimum="0" Maximum="100" Value="100" ValueChanged="OnInsFilterChanged" />
                                    <Button Content="Restablecer filtros" HorizontalAlignment="Stretch" Click="OnInsResetFilters" />
                                </StackPanel>

                                <!-- Título -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="TÍTULO" Style="{StaticResource SectionTitle}" />
                                    <TextBox x:Name="InsCaptionText" PlaceholderText="Texto del título"
                                             TextChanged="OnInsCaptionTextChanged" />
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Posición" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="InsCaptionPos" HorizontalAlignment="Stretch" SelectionChanged="OnInsCaptionPosChanged">
                                            <ComboBoxItem Content="Ninguno" />
                                            <ComboBoxItem Content="Debajo" />
                                            <ComboBoxItem Content="Arriba" />
                                            <ComboBoxItem Content="Encima" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Origen" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="InsCaptionSource" HorizontalAlignment="Stretch" SelectionChanged="OnInsCaptionSourceChanged">
                                            <ComboBoxItem Content="Manual" />
                                            <ComboBoxItem Content="Nombre (sin extensión)" />
                                            <ComboBoxItem Content="Nombre (con extensión)" />
                                            <ComboBoxItem Content="Numeración" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Tipografía" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="InsCaptionFont" HorizontalAlignment="Stretch" SelectionChanged="OnInsCaptionStyleChanged">
                                            <ComboBoxItem Content="Segoe UI" />
                                            <ComboBoxItem Content="Arial" />
                                            <ComboBoxItem Content="Georgia" />
                                            <ComboBoxItem Content="Courier New" />
                                            <ComboBoxItem Content="Times New Roman" />
                                            <ComboBoxItem Content="Verdana" />
                                            <ComboBoxItem Content="Impact" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="Tamaño de fuente" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="InsCaptionSize" Minimum="6" Maximum="48" Value="14" ValueChanged="OnInsCaptionSlider" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Texto" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                            <Button Width="38" Height="26" Padding="0">
                                                <Border x:Name="InsCapColorSwatch" Background="White" Width="24" Height="14"
                                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <ColorPicker x:Name="InsCapColorPicker" ColorSpectrumShape="Ring"
                                                                     IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                                                     IsHexInputVisible="True" ColorChanged="OnInsCaptionColor" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Fondo" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                            <Button Width="38" Height="26" Padding="0">
                                                <Border x:Name="InsCapBgSwatch" Background="#8C000000" Width="24" Height="14"
                                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" />
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <ColorPicker x:Name="InsCapBgPicker" ColorSpectrumShape="Ring"
                                                                     IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                                                     IsAlphaEnabled="True" IsHexInputVisible="True" ColorChanged="OnInsCaptionBg" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Content="Usar título global" HorizontalAlignment="Stretch"
                                            Click="OnInsCaptionUseGlobal" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
