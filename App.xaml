<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ImprimePlus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImprimePlus"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Paleta Imprime+ (mapeo 1:1 de editor.css :root) ===== -->
            <Color x:Key="ColBg">#FFE8EDF3</Color>
            <Color x:Key="ColBgPanel">#FFF0F4F8</Color>
            <Color x:Key="ColBorder">#FFC7D2E0</Color>
            <Color x:Key="ColAccent">#FF3B82F6</Color>
            <Color x:Key="ColAccentHover">#FF2563EB</Color>
            <Color x:Key="ColText">#FF1E293B</Color>
            <Color x:Key="ColTextMuted">#FF64748B</Color>
            <Color x:Key="ColPanelText">#FF334155</Color>
            <Color x:Key="ColInputBg">#FFFFFFFF</Color>
            <Color x:Key="ColDanger">#FFEF4444</Color>
            <Color x:Key="ColHover">#FFDBEAFE</Color>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ColBg}" />
            <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource ColBgPanel}" />
            <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource ColBorder}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColAccent}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColAccentHover}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColText}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColTextMuted}" />
            <SolidColorBrush x:Key="PanelTextBrush" Color="{StaticResource ColPanelText}" />
            <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource ColInputBg}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColDanger}" />
            <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource ColHover}" />

            <!-- ===== Botón de toolbar (.tb-btn) ===== -->
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="9,5,9,5" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- ===== Título de sección del panel (.panel-section-title) ===== -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
